{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hakertone-app",
  "main": "src/index.js",
  "compatibility_date": "2026-09-19",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "html_handling": "auto-trailing-slash"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hakertone-db",
      "database_id": "b22150b0-1d56-4af4-b0ac-8f5af75cba68"
    }
  ],

  "ratelimits": [
    {
      "name": "VOTE_RATE_LIMITER",
      "namespace_id": "91001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}